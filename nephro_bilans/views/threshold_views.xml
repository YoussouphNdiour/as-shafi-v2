<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view -->
    <record id="nephro_threshold_view_list" model="ir.ui.view">
        <field name="name">nephro.bilan.threshold.list</field>
        <field name="model">nephro.bilan.threshold</field>
        <field name="arch" type="xml">
            <list>
                <field name="parameter"/>
                <field name="min_value"/>
                <field name="max_value"/>
                <field name="unit"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="nephro_threshold_view_form" model="ir.ui.view">
        <field name="name">nephro.bilan.threshold.form</field>
        <field name="model">nephro.bilan.threshold</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="parameter"/>
                        <field name="min_value"/>
                        <field name="max_value"/>
                        <field name="unit"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="nephro_threshold_action" model="ir.actions.act_window">
        <field name="name">Seuils des bilans</field>
        <field name="res_model">nephro.bilan.threshold</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
