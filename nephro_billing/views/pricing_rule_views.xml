<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Pricing Rule List View -->
    <record id="nephro_pricing_rule_view_list" model="ir.ui.view">
        <field name="name">nephro.pricing.rule.list</field>
        <field name="model">nephro.pricing.rule</field>
        <field name="arch" type="xml">
            <list string="Pricing Rules">
                <field name="name"/>
                <field name="price"/>
                <field name="tax_rate"/>
                <field name="insurance_coverage"/>
                <field name="patient_share"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Pricing Rule Form View -->
    <record id="nephro_pricing_rule_view_form" model="ir.ui.view">
        <field name="name">nephro.pricing.rule.form</field>
        <field name="model">nephro.pricing.rule</field>
        <field name="arch" type="xml">
            <form string="Pricing Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Rule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Pricing">
                            <field name="price"/>
                            <field name="tax_rate"/>
                        </group>
                        <group string="Insurance">
                            <field name="insurance_coverage"/>
                            <field name="patient_share"/>
                        </group>
                    </group>
                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pricing Rule Action -->
    <record id="nephro_pricing_rule_action" model="ir.actions.act_window">
        <field name="name">Pricing Rules</field>
        <field name="res_model">nephro.pricing.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
