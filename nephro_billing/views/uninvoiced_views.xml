<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Uninvoiced Sessions Action -->
    <record id="nephro_uninvoiced_sessions_action" model="ir.actions.act_window">
        <field name="name">Séances non facturées</field>
        <field name="res_model">nephro.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'done'), ('is_invoiced', '=', False)]</field>
        <field name="context">{'default_state': 'done'}</field>
    </record>

    <!-- All Invoices Action (shortcut to account.move) -->
    <record id="nephro_billing_all_invoices_action" model="ir.actions.act_window">
        <field name="name">Toutes les factures</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
</odoo>
