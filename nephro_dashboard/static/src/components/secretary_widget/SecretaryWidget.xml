<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nephro_dashboard.SecretaryWidget">
        <div class="o_secretary_widget p-3">
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="min-height:120px">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement…</span>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="d-flex align-items-center mb-3">
                    <h4 class="mb-0 me-auto">Résumé du jour</h4>
                    <small class="text-muted">Actualisation auto toutes les 30 s</small>
                </div>

                <!-- Day counters -->
                <div class="row g-2 mb-3">
                    <div class="col-6 col-sm-4 col-lg-2">
                        <div class="card border-primary text-center p-2">
                            <h3 class="mb-0 text-primary" t-esc="state.total"/>
                            <small class="text-muted">Total</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2">
                        <div class="card border-info text-center p-2">
                            <h3 class="mb-0 text-info" t-esc="state.scheduled"/>
                            <small class="text-muted">Planifiées</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2">
                        <div class="card border-warning text-center p-2">
                            <h3 class="mb-0 text-warning" t-esc="state.running"/>
                            <small class="text-muted">En cours</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2">
                        <div class="card border-success text-center p-2">
                            <h3 class="mb-0 text-success" t-esc="state.done"/>
                            <small class="text-muted">Terminées</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2">
                        <div class="card border-danger text-center p-2">
                            <h3 class="mb-0 text-danger" t-esc="state.absent"/>
                            <small class="text-muted">Absent</small>
                        </div>
                    </div>
                    <div class="col-6 col-sm-4 col-lg-2">
                        <div class="card border-secondary text-center p-2">
                            <h3 class="mb-0 text-secondary">
                                <t t-esc="state.stations_occupied"/>/<t t-esc="state.stations_total"/>
                            </h3>
                            <small class="text-muted">Postes</small>
                        </div>
                    </div>
                </div>

                <!-- Occupancy progress bar -->
                <div t-if="state.stations_total > 0">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Occupation des postes</small>
                        <small class="text-muted">
                            <t t-esc="state.stations_occupied"/> /
                            <t t-esc="state.stations_total"/>
                        </small>
                    </div>
                    <div class="progress" style="height:10px">
                        <div class="progress-bar bg-warning"
                             t-attf-style="width:#{Math.round(state.stations_occupied / state.stations_total * 100)}%"
                             t-attf-aria-valuenow="#{state.stations_occupied}"
                             aria-valuemin="0"
                             t-attf-aria-valuemax="#{state.stations_total}"/>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
