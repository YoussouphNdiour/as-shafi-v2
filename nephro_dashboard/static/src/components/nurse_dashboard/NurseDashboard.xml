<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nephro_dashboard.NurseDashboard">
        <div class="o_nurse_dashboard p-3">
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="min-height:200px">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement…</span>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="d-flex align-items-center mb-4">
                    <h2 class="mb-0 me-auto">Interface infirmier</h2>
                    <small class="text-muted">Actualisation auto toutes les 30 s</small>
                </div>

                <t t-if="!state.patients.length">
                    <div class="alert alert-info text-center">
                        Aucune séance assignée aujourd'hui.
                    </div>
                </t>

                <div class="row g-3">
                    <t t-foreach="state.patients" t-as="p" t-key="p.procedure_id">
                        <div class="col-12 col-md-6 col-xl-4">
                            <div t-attf-class="card h-100 border-#{this.getStatusClass(p.state)}">
                                <!-- Card header: station + status badge -->
                                <div t-attf-class="card-header d-flex justify-content-between align-items-center bg-#{this.getStatusClass(p.state)} bg-opacity-10">
                                    <strong t-esc="p.station || 'Sans poste'"/>
                                    <span t-attf-class="badge text-bg-#{this.getStatusClass(p.state)}"
                                          t-esc="p.state"/>
                                </div>

                                <!-- Card body: patient info -->
                                <div class="card-body">
                                    <h5 class="card-title mb-2" t-esc="p.patient_name"/>

                                    <!-- Running: elapsed time bar -->
                                    <t t-if="p.state === 'running'">
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between">
                                                <small class="text-muted">Écoulé</small>
                                                <small><t t-esc="this.formatElapsed(p.elapsed_minutes)"/>
                                                    / <t t-esc="this.formatElapsed(p.duration_planned)"/>
                                                </small>
                                            </div>
                                            <div class="progress mt-1" style="height:8px">
                                                <div class="progress-bar bg-warning"
                                                     t-attf-style="width:#{p.duration_planned > 0 ? Math.min(100, Math.round(p.elapsed_minutes / p.duration_planned * 100)) : 0}%"/>
                                            </div>
                                        </div>
                                    </t>

                                    <!-- Indicators -->
                                    <div class="d-flex gap-2 flex-wrap mb-2">
                                        <t t-if="p.has_complication">
                                            <span class="badge text-bg-danger">
                                                Complication
                                            </span>
                                        </t>
                                        <span class="badge text-bg-secondary">
                                            <t t-esc="p.vital_signs_count"/> VS
                                        </span>
                                    </div>
                                </div>

                                <!-- Touch-friendly action buttons -->
                                <div class="card-footer d-flex flex-wrap gap-2">
                                    <!-- Start button (scheduled only) -->
                                    <t t-if="p.state === 'scheduled'">
                                        <button class="btn btn-success flex-fill"
                                                style="min-height:48px;font-size:1rem"
                                                t-on-click="() => this.onStartSession(p.procedure_id)">
                                            Démarrer
                                        </button>
                                        <button class="btn btn-outline-danger flex-fill"
                                                style="min-height:48px;font-size:1rem"
                                                t-on-click="() => this.onMarkAbsent(p.procedure_id)">
                                            Absent
                                        </button>
                                    </t>

                                    <!-- Complete button (running only) -->
                                    <t t-if="p.state === 'running'">
                                        <button class="btn btn-primary flex-fill"
                                                style="min-height:48px;font-size:1rem"
                                                t-on-click="() => this.onCompleteSession(p.procedure_id)">
                                            Terminer
                                        </button>
                                        <button class="btn btn-outline-secondary flex-fill"
                                                style="min-height:48px;font-size:1rem"
                                                t-on-click="() => this.onOpenSession(p.procedure_id)">
                                            Détails
                                        </button>
                                    </t>

                                    <!-- Done / cancelled: view only -->
                                    <t t-if="p.state === 'done' || p.state === 'cancel'">
                                        <button class="btn btn-outline-secondary w-100"
                                                style="min-height:48px;font-size:1rem"
                                                t-on-click="() => this.onOpenSession(p.procedure_id)">
                                            Voir la séance
                                        </button>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
