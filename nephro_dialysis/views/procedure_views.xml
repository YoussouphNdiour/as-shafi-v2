<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nephro_dialysis_procedure_view_form" model="ir.ui.view">
        <field name="name">nephro.procedure.form.dialysis</field>
        <field name="model">nephro.procedure</field>
        <field name="inherit_id" ref="nephro_core.nephro_core_procedure_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">

                <!-- Pre-dialysis tab -->
                <page string="Pré-dialyse">
                    <group>
                        <group string="Poids">
                            <field name="dry_weight"/>
                            <field name="pre_weight"/>
                            <field name="interdialytic_weight_gain" readonly="1"/>
                            <field name="target_uf" readonly="1"/>
                        </group>
                        <group string="Mesures">
                            <field name="pre_bp"/>
                            <field name="pre_bp_standing"/>
                            <field name="pre_bp_lying"/>
                            <field name="pre_temp"/>
                            <field name="arrival_status"/>
                        </group>
                    </group>
                    <group string="UF et adéquation dialyse">
                        <group>
                            <field name="uf_habituelle"/>
                            <field name="uf_max"/>
                        </group>
                        <group>
                            <field name="last_ktv_sp"/>
                            <field name="last_ktv_dp"/>
                            <field name="last_pru"/>
                        </group>
                    </group>
                </page>

                <!-- Machine Parameters tab -->
                <page string="Paramètres machine">
                    <group>
                        <group string="Affectation">
                            <field name="schedule_id"/>
                            <field name="station_id" required="1"/>
                            <field name="vascular_access_id"/>
                            <field name="dialyzer_id"/>
                            <field name="dialysate_id"/>
                        </group>
                        <group string="Abord et ponction">
                            <field name="needle_type"/>
                            <field name="puncture_type"/>
                            <field name="puncture_unipuncture"
                                invisible="puncture_type != 'unipuncture'"/>
                            <field name="anticoagulation"/>
                            <field name="anticoag_dose"/>
                        </group>
                    </group>
                    <group>
                        <field name="parameter_change_reason" colspan="2"/>
                    </group>
                </page>

                <!-- Vital Signs tab -->
                <page string="Signes vitaux">
                    <field name="vital_sign_ids">
                        <list editable="bottom">
                            <field name="timestamp"/>
                            <field name="systolic_bp" string="TA sys"/>
                            <field name="diastolic_bp" string="TA dia"/>
                            <field name="heart_rate"/>
                            <field name="spo2"/>
                            <field name="temperature"/>
                            <field name="dextro"/>
                            <field name="is_alert" readonly="1"
                                decoration-danger="is_alert"/>
                        </list>
                    </field>
                </page>

                <!-- Post-dialysis tab -->
                <page string="Post-dialyse">
                    <group>
                        <group string="Mesures">
                            <field name="post_weight"/>
                            <field name="post_bp"/>
                            <field name="actual_uf" readonly="1"/>
                            <field name="global_tolerance"/>
                            <field name="dialyzer_state"/>
                            <field name="restitution"/>
                        </group>
                        <group string="Adéquation">
                            <field name="ktv" readonly="1"/>
                            <field name="ktv_status" readonly="1"/>
                            <field name="urr" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="end_notes" colspan="2"/>
                    </group>
                </page>

                <!-- Machine Readings tab -->
                <page string="Relevés machine">
                    <field name="machine_param_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="timestamp"/>
                            <field name="blood_flow"/>
                            <field name="pa"/>
                            <field name="pv"/>
                            <field name="ptm"/>
                            <field name="uf_h"/>
                            <field name="uf_total"/>
                            <field name="conductivity"/>
                            <field name="dialysate_temp"/>
                            <field name="dialysate_flow"/>
                        </list>
                    </field>
                </page>

            </xpath>
        </field>
    </record>
</odoo>
