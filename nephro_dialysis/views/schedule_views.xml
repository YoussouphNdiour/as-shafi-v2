<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nephro_dialysis_schedule_view_list" model="ir.ui.view">
        <field name="name">nephro.schedule.list</field>
        <field name="model">nephro.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="station_id"/>
                <field name="physician_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="nephro_dialysis_schedule_view_form" model="ir.ui.view">
        <field name="name">nephro.schedule.form</field>
        <field name="model">nephro.schedule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                        invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du programme"/></h1>
                    </div>
                    <group>
                        <group string="Général">
                            <field name="code"/>
                            <field name="station_id"/>
                            <field name="physician_id"/>
                            <field name="nurse_ids" widget="many2many_tags"/>
                            <field name="max_patients"/>
                        </group>
                        <group string="Horaires">
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Jours">
                        <group>
                            <field name="monday"/>
                            <field name="tuesday"/>
                            <field name="wednesday"/>
                        </group>
                        <group>
                            <field name="thursday"/>
                            <field name="friday"/>
                            <field name="saturday"/>
                            <field name="sunday"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nephro_dialysis_schedule_action" model="ir.actions.act_window">
        <field name="name">Programmes</field>
        <field name="res_model">nephro.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
