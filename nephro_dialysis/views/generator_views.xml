<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Session Generator Wizard Form View -->
    <record id="nephro_dialysis_session_generator_view_form" model="ir.ui.view">
        <field name="name">nephro.session.generator.form</field>
        <field name="model">nephro.session.generator</field>
        <field name="arch" type="xml">
            <form string="Générer des séances de dialyse">
                <group>
                    <group string="Patients">
                        <field name="patient_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Programme">
                        <field name="schedule_id"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="exclude_holidays"/>
                    </group>
                </group>
                <group>
                    <field name="preview_count" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                        string="Générer les séances" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Session Generator Action -->
    <record id="nephro_dialysis_session_generator_action" model="ir.actions.act_window">
        <field name="name">Générer des séances</field>
        <field name="res_model">nephro.session.generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
