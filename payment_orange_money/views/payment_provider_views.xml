<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_orange_money_form_inherit" model="ir.ui.view">
        <field name="name">payment.provider.orange_money.form.inherit</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group string="Orange Money Credentials"
                       attrs="{'invisible': [('code', '!=', 'orange_money')]}">
                    <field name="orange_money_api_key"
                           password="True"
                           attrs="{'required': [('code', '=', 'orange_money')]}"/>
                    <field name="orange_money_secret_key"
                           password="True"
                           attrs="{'required': [('code', '=', 'orange_money')]}"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
